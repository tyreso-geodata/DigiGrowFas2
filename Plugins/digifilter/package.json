{
  "name": "digifilter-plugin",
  "version": "1.0.0",
  "description": "Project filtering and spatial queries for Tyresö kommun",
  "main": "digifilter.js",
  "scripts": {
    "start": "npm-run-all --parallel watch-js watch-sass",
    "watch-js": "webpack-dev-server --config ./tasks/webpack.dev.js --mode development",
    "watch-sass": "node-sass -w --include-path scss scss/digifilter.scss ../origo/plugins/digifilter.css",
    "prewatch-sass": "node-sass --include-path scss scss/digifilter.scss ../origo/plugins/digifilter.css",
    "build": "webpack --config ./tasks/webpack.prod.js && npm run build-sass",
    "build-sass": "node-sass --include-path scss scss/digifilter.scss build/css/digifilter.css"
  },
  "author": "Origo",
  "license": "MIT",
  "dependencies": {
    "npm-run-all2": "^6.2.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.30.0",
    "mini-css-extract-plugin": "^2.9.1",
    "node-sass": "^9.0.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  }
}
